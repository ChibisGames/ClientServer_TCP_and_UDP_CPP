#!/usr/bin/expect -f
# test_read.expect - Параметризованный тест основного функционала клиента
# Обновлен для работы с новым UDP протоколом
# Использование: ./test_read.expect <client_path> <graph_file> <start> <end> <expected_length> <expected_path> <protocol> <port>
# Для теста с ошибкой передать:
#   expected_length="ERROR" и expected_path="ERROR_GRAPH_TOO_SMALL"
#   expected_length="ERROR" и expected_path="ERROR_VERTEX_NOT_FOUND"
#   expected_length="ERROR" и expected_path="ERROR_START_VERTEX_NOT_FOUND"
#   expected_length="ERROR" и expected_path="ERROR_GRAPH_TOO_LARGE"
#   expected_length="NO_PATH" и expected_path="VERTICES_NOT_CONNECTED"

set timeout 1

# Получаем параметры из аргументов командной строки
if {[llength $argv] != 8} {
    puts "Ошибка: Неверное количество параметров"
    puts "Использование: ./test_read.expect <client_path> <graph_file> <start> <end> <expected_length> <expected_path> <protocol> <port>"
    puts "Для теста с ошибкой передать:"
    puts "  expected_length=\"ERROR\" и expected_path=\"ERROR_GRAPH_TOO_SMALL\""
    puts "  expected_length=\"ERROR\" и expected_path=\"ERROR_VERTEX_NOT_FOUND\""
    puts "  expected_length=\"ERROR\" и expected_path=\"ERROR_START_VERTEX_NOT_FOUND\""
    puts "  expected_length=\"ERROR\" и expected_path=\"ERROR_GRAPH_TOO_LARGE\""
    puts "  expected_length=\"NO_PATH\" и expected_path=\"VERTICES_NOT_CONNECTED\""
    exit 1
}

set client_path [lindex $argv 0]
set graph_file [lindex $argv 1]
set start_vertex [lindex $argv 2]
set end_vertex [lindex $argv 3]
set expected_length [lindex $argv 4]
set expected_path [lindex $argv 5]
set protocol [lindex $argv 6]
set port [lindex $argv 7]

# Запускаем клиент с протоколом и портом
spawn $client_path 127.0.0.1 $protocol $port

# Ожидаем приветствие клиента
expect {
    "клиент запущен" {
        puts "✓ Клиент успешно запущен"
    }
    "UDP клиент запущен" {
        puts "✓ UDP клиент успешно запущен"
    }
    timeout {
        puts "✗ Таймаут при запуске клиента"
        exit 1
    }
}

expect "Пожалуйста, выберите способ задания графа: 'input' или 'read' (из файла)?"
expect "Input << "
send "read\r"

expect "Введите название файла: "
send "$graph_file\r"

# Ждем обработки файла - для UDP может потребоваться больше времени
sleep 1

expect "Введите начальную вершину (однозначное или двухзначное число): "
send "$start_vertex\r"

expect "Введите конечную вершину (однозначное или двухзначное число): "
send "$end_vertex\r"

# Для UDP ждем немного дольше обработки
if {$protocol == "udp"} {
    sleep 1
}

# Проверяем, ожидаем ли мы ошибку "граф слишком маленький"
if {$expected_length == "ERROR" && $expected_path == "ERROR_GRAPH_TOO_SMALL"} {
    puts "Ожидается ошибка: Граф должен содержать не менее 6 вершин и 6 рёбер"

    expect {
        "Граф должен содержать не менее 6 вершин и 6 рёбер" {
            puts "✓ Получена ожидаемая ошибка: Граф слишком маленький"

            # После ошибки ожидаем повторный запрос выбора способа
            expect "Пожалуйста, выберите способ задания графа: 'input' или 'read' (из файла)?"
            expect "Input << "
            send "exit\r"

            expect {
                "Клиент отключен" {
                    puts "✅ Тест с ошибкой (маленький граф) пройден успешно"
                    exit 0
                }
                eof {
                    puts "✅ Тест с ошибкой (маленький граф) пройден успешно"
                    exit 0
                }
                timeout {
                    puts "⚠ Клиент не отключился, но тест пройден"
                    exit 0
                }
            }
        }
        "Конечной вершины нет в графе!" {
            puts "✗ Ошибка: Ожидалась ошибка о маленьком графе, но получена ошибка об отсутствии конечной вершины"
            exit 1
        }
        "Начальной вершины нет в графе!" {
            puts "✗ Ошибка: Ожидалась ошибка о маленьком графе, но получена ошибка об отсутствии начальной вершины"
            exit 1
        }
        "Граф должен содержать не более 20 вершин" {
            puts "✗ Ошибка: Ожидалась ошибка о маленьком графе, но получена ошибка о слишком большом графе"
            exit 1
        }
        "Вершины не соединены!" {
            puts "✗ Ошибка: Ожидалась ошибка о маленьком графе, но получено сообщение о несвязности вершин"
            exit 1
        }
        "Результат длины пути" {
            puts "✗ Ошибка: Ожидалась ошибка о маленьком графе, но получен результат длины пути"
            exit 1
        }
        "Результат пути" {
            puts "✗ Ошибка: Ожидалась ошибка о маленьком графе, но получен результат пути"
            exit 1
        }
        "путь между вершинами не существует" {
            puts "✗ Ошибка: Ожидалась ошибка о маленьком графе, но получено сообщение о несуществующем пути"
            exit 1
        }
        "Сервер вернул ошибку: некорректные данные графа" {
            puts "✗ Ошибка: Сервер вернул ошибку о некорректных данных"
            exit 1
        }
        "Не удалось получить результат" {
            puts "✗ Ошибка: Не удалось получить результат от сервера"
            exit 1
        }
        timeout {
            puts "✗ Таймаут при ожидании ошибки о маленьком графе"
            exit 1
        }
    }
} elseif {$expected_length == "ERROR" && $expected_path == "ERROR_VERTEX_NOT_FOUND"} {
    puts "Ожидается ошибка: Конечной вершины нет в графе!"

    expect {
        "Конечной вершины нет в графе!" {
            puts "✓ Получена ожидаемая ошибка: Конечной вершины нет в графе!"

            # После ошибки ожидаем повторный запрос выбора способа
            expect "Пожалуйста, выберите способ задания графа: 'input' или 'read' (из файла)?"
            expect "Input << "
            send "exit\r"

            expect {
                "Клиент отключен" {
                    puts "✅ Тест с ошибкой (конечная вершина не найдена) пройден успешно"
                    exit 0
                }
                eof {
                    puts "✅ Тест с ошибкой (конечная вершина не найдена) пройден успешно"
                    exit 0
                }
                timeout {
                    puts "⚠ Клиент не отключился, но тест пройден"
                    exit 0
                }
            }
        }
        "Граф должен содержать не менее 6 вершин и 6 рёбер" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии конечной вершины, но получена ошибка о маленьком графе"
            exit 1
        }
        "Начальной вершины нет в графе!" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии конечной вершины, но получена ошибка об отсутствии начальной вершины"
            exit 1
        }
        "Граф должен содержать не более 20 вершин" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии конечной вершины, но получена ошибка о слишком большом графе"
            exit 1
        }
        "Вершины не соединены!" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии конечной вершины, но получено сообщение о несвязности вершин"
            exit 1
        }
        "Результат длины пути" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии конечной вершины, но получен результат длины пути"
            exit 1
        }
        "Результат пути" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии конечной вершины, но получен результат пути"
            exit 1
        }
        "путь между вершинами не существует" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии конечной вершины, но получено сообщение о несуществующем пути"
            exit 1
        }
        "Сервер вернул ошибку: некорректные данные графа" {
            puts "✗ Ошибка: Сервер вернул ошибку о некорректных данных"
            exit 1
        }
        "Не удалось получить результат" {
            puts "✗ Ошибка: Не удалось получить результат от сервера"
            exit 1
        }
        timeout {
            puts "✗ Таймаут при ожидании ошибки об отсутствии конечной вершины"
            exit 1
        }
    }
} elseif {$expected_length == "ERROR" && $expected_path == "ERROR_START_VERTEX_NOT_FOUND"} {
    puts "Ожидается ошибка: Начальной вершины нет в графе!"

    expect {
        "Начальной вершины нет в графе!" {
            puts "✓ Получена ожидаемая ошибка: Начальной вершины нет в графе!"

            # После ошибки ожидаем повторный запрос выбора способа
            expect "Пожалуйста, выберите способ задания графа: 'input' или 'read' (из файла)?"
            expect "Input << "
            send "exit\r"

            expect {
                "Клиент отключен" {
                    puts "✅ Тест с ошибкой (начальная вершина не найдена) пройден успешно"
                    exit 0
                }
                eof {
                    puts "✅ Тест с ошибкой (начальная вершина не найдена) пройден успешно"
                    exit 0
                }
                timeout {
                    puts "⚠ Клиент не отключился, но тест пройден"
                    exit 0
                }
            }
        }
        "Граф должен содержать не менее 6 вершин и 6 рёбер" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии начальной вершины, но получена ошибка о маленьком графе"
            exit 1
        }
        "Конечной вершины нет в графе!" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии начальной вершины, но получена ошибка об отсутствии конечной вершины"
            exit 1
        }
        "Граф должен содержать не более 20 вершин" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии начальной вершины, но получена ошибка о слишком большом графе"
            exit 1
        }
        "Вершины не соединены!" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии начальной вершины, но получено сообщение о несвязности вершин"
            exit 1
        }
        "Результат длины пути" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии начальной вершины, но получен результат длины пути"
            exit 1
        }
        "Результат пути" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии начальной вершины, но получен результат пути"
            exit 1
        }
        "путь между вершинами не существует" {
            puts "✗ Ошибка: Ожидалась ошибка об отсутствии начальной вершины, но получено сообщение о несуществующем пути"
            exit 1
        }
        "Сервер вернул ошибку: некорректные данные графа" {
            puts "✗ Ошибка: Сервер вернул ошибку о некорректных данных"
            exit 1
        }
        "Не удалось получить результат" {
            puts "✗ Ошибка: Не удалось получить результат от сервера"
            exit 1
        }
        timeout {
            puts "✗ Таймаут при ожидании ошибки об отсутствии начальной вершины"
            exit 1
        }
    }
} elseif {$expected_length == "ERROR" && $expected_path == "ERROR_GRAPH_TOO_LARGE"} {
    puts "Ожидается ошибка: Граф должен содержать не более 20 вершин"

    expect {
        "Граф должен содержать не более 20 вершин" {
            puts "✓ Получена ожидаемая ошибка: Граф должен содержать не более 20 вершин"

            # После ошибки ожидаем повторный запрос выбора способа
            expect "Пожалуйста, выберите способ задания графа: 'input' или 'read' (из файла)?"
            expect "Input << "
            send "exit\r"

            expect {
                "Клиент отключен" {
                    puts "✅ Тест с ошибкой (слишком большой граф) пройден успешно"
                    exit 0
                }
                eof {
                    puts "✅ Тест с ошибкой (слишком большой граф) пройден успешно"
                    exit 0
                }
                timeout {
                    puts "⚠ Клиент не отключился, но тест пройден"
                    exit 0
                }
            }
        }
        "Граф должен содержать не менее 6 вершин и 6 рёбер" {
            puts "✗ Ошибка: Ожидалась ошибка о слишком большом графе, но получена ошибка о маленьком графе"
            exit 1
        }
        "Конечной вершины нет в графе!" {
            puts "✗ Ошибка: Ожидалась ошибка о слишком большом графе, но получена ошибка об отсутствии конечной вершины"
            exit 1
        }
        "Начальной вершины нет в графе!" {
            puts "✗ Ошибка: Ожидалась ошибка о слишком большом графе, но получена ошибка об отсутствии начальной вершины"
            exit 1
        }
        "Вершины не соединены!" {
            puts "✗ Ошибка: Ожидалась ошибка о слишком большом графе, но получено сообщение о несвязности вершин"
            exit 1
        }
        "Результат длины пути" {
            puts "✗ Ошибка: Ожидалась ошибка о слишком большом графе, но получен результат длины пути"
            exit 1
        }
        "Результат пути" {
            puts "✗ Ошибка: Ожидалась ошибка о слишком большом графе, но получен результат пути"
            exit 1
        }
        "путь между вершинами не существует" {
            puts "✗ Ошибка: Ожидалась ошибка о слишком большом графе, но получено сообщение о несуществующем пути"
            exit 1
        }
        "Сервер вернул ошибку: некорректные данные графа" {
            puts "✗ Ошибка: Сервер вернул ошибку о некорректных данных"
            exit 1
        }
        "Не удалось получить результат" {
            puts "✗ Ошибка: Не удалось получить результат от сервера"
            exit 1
        }
        timeout {
            puts "✗ Таймаут при ожидании ошибки о слишком большом графе"
            exit 1
        }
    }
} elseif {$expected_length == "NO_PATH" && $expected_path == "VERTICES_NOT_CONNECTED"} {
    puts "Ожидается сообщение: Вершины не соединены!"

    # Ожидаем сообщение о длине пути (несвязные вершины)
    expect {
        "Вершины не соединены!" {
            puts "✓ Получено ожидаемое сообщение: Вершины не соединены!"

            # Ожидаем сообщение о пути (несвязные вершины)
            expect {
                "путь между вершинами не существует" {
                    puts "✓ Получено ожидаемое сообщение: путь между вершинами не существует"

                    # После вывода результатов ожидаем повторный запрос выбора способа
                    expect "Пожалуйста, выберите способ задания графа: 'input' или 'read' (из файла)?"
                    expect "Input << "
                    send "exit\r"

                    expect {
                        "Клиент отключен" {
                            puts "✅ Тест с несвязными вершинами пройден успешно"
                            exit 0
                        }
                        eof {
                            puts "✅ Тест с несвязными вершинами пройден успешно"
                            exit 0
                        }
                        timeout {
                            puts "⚠ Клиент не отключился, но тест пройден"
                            exit 0
                        }
                    }
                }
                -re "Результат пути.*: (.*)" {
                    set actual_path $expect_out(1,string)
                    puts "✗ Неверное сообщение о пути. Ожидалось: 'путь между вершинами не существует', Получено: '$actual_path'"
                    exit 1
                }
                "Результат пути" {
                    puts "✗ Получен результат пути, но ожидалось сообщение 'путь между вершинами не существует'"
                    exit 1
                }
                "Граф должен содержать не менее 6 вершин и 6 рёбер" {
                    puts "✗ Ошибка: Ожидалось сообщение о несвязности вершин, но получена ошибка о маленьком графе"
                    exit 1
                }
                "Конечной вершины нет в графе!" {
                    puts "✗ Ошибка: Ожидалось сообщение о несвязности вершин, но получена ошибка об отсутствии конечной вершины"
                    exit 1
                }
                "Начальной вершины нет в графе!" {
                    puts "✗ Ошибка: Ожидалось сообщение о несвязности вершин, но получена ошибка об отсутствии начальной вершины"
                    exit 1
                }
                "Граф должен содержать не более 20 вершин" {
                    puts "✗ Ошибка: Ожидалось сообщение о несвязности вершин, но получена ошибка о слишком большом графе"
                    exit 1
                }
                timeout {
                    puts "✗ Таймаут при ожидании результата пути"
                    exit 1
                }
            }
        }
        -re "Результат длины пути.*: (\[0-9\]+)" {
            set actual_length $expect_out(1,string)
            puts "✗ Неверная длина пути. Ожидалось сообщение 'Вершины не соединены!', Получено: $actual_length"
            exit 1
        }
        "Граф должен содержать не менее 6 вершин и 6 рёбер" {
            puts "✗ Ошибка: Ожидалось сообщение о несвязности вершин, но получена ошибка о маленьком графе"
            exit 1
        }
        "Конечной вершины нет в графе!" {
            puts "✗ Ошибка: Ожидалось сообщение о несвязности вершин, но получена ошибка об отсутствии конечной вершины"
            exit 1
        }
        "Начальной вершины нет в графе!" {
            puts "✗ Ошибка: Ожидалось сообщение о несвязности вершин, но получена ошибка об отсутствии начальной вершины"
            exit 1
        }
        "Граф должен содержать не более 20 вершин" {
            puts "✗ Ошибка: Ожидалось сообщение о несвязности вершин, но получена ошибка о слишком большом графе"
            exit 1
        }
        timeout {
            puts "✗ Таймаут при ожидании результата длины пути"
            exit 1
        }
    }
} else {
    # Обычный тест - ожидаем нормальный результат

    # Проверяем длину пути - теперь учитываем формат вывода из printResult
    expect {
        -re "Результат длины пути \\(от $start_vertex до $end_vertex\\): $expected_length" {
            puts "✓ Длина пути совпадает: $expected_length"
        }
        -re "Результат длины пути.*: $expected_length" {
            puts "✓ Длина пути совпадает: $expected_length"
        }
        -re "Результат длины пути.*: (\[0-9\]+)" {
            set actual_length $expect_out(1,string)
            if {$actual_length == $expected_length} {
                puts "✓ Длина пути совпадает: $expected_length"
            } else {
                puts "✗ Неверная длина пути. Ожидалось: $expected_length, Получено: $actual_length"
                exit 1
            }
        }
        "Вершины не соединены!" {
            puts "✗ Ошибка: Получено сообщение о несвязности вершин, но ожидалась длина пути $expected_length"
            exit 1
        }
        "Граф должен содержать не менее 6 вершин и 6 рёбер" {
            puts "✗ Ошибка: Получена ошибка о маленьком графе, но ожидался результат пути"
            exit 1
        }
        "Конечной вершины нет в графе!" {
            puts "✗ Ошибка: Получена ошибка об отсутствии конечной вершины, но ожидался результат пути"
            exit 1
        }
        "Начальной вершины нет в графе!" {
            puts "✗ Ошибка: Получена ошибка об отсутствии начальной вершины, но ожидался результат пути"
            exit 1
        }
        "Граф должен содержать не более 20 вершин" {
            puts "✗ Ошибка: Получена ошибка о слишком большом графе, но ожидался результат пути"
            exit 1
        }
        "Сервер вернул ошибку: некорректные данные графа" {
            puts "✗ Ошибка: Сервер вернул ошибку о некорректных данных"
            exit 1
        }
        "Не удалось получить результат" {
            puts "✗ Ошибка: Не удалось получить результат от сервера"
            exit 1
        }
        timeout {
            puts "✗ Таймаут при получении длины пути"
            exit 1
        }
    }

    # Проверяем путь - теперь учитываем формат вывода из printResult
    expect {
        "Результат пути (из $start_vertex до $end_vertex): $expected_path" {
            puts "✓ Путь совпадает: $expected_path"
        }
        -re "Результат пути.*: $expected_path" {
            puts "✓ Путь совпадает: $expected_path"
        }
        -re "Результат пути.*: (.*)" {
            set actual_path $expect_out(1,string)
            # Убираем возможные пробелы в начале
            set actual_path [string trim $actual_path]

            if {$actual_path == $expected_path} {
                puts "✓ Путь совпадает: $expected_path"
            } else {
                puts "✗ Неверный путь. Ожидалось: '$expected_path', Получено: '$actual_path'"
                exit 1
            }
        }
        "путь между вершинами не существует" {
            puts "✗ Ошибка: Получено сообщение о несуществующем пути, но ожидался путь: $expected_path"
            exit 1
        }
        "Граф должен содержать не менее 6 вершин и 6 рёбер" {
            puts "✗ Ошибка: Получена ошибка о маленьком графе, но ожидался результат пути"
            exit 1
        }
        "Конечной вершины нет в графе!" {
            puts "✗ Ошибка: Получена ошибка об отсутствии конечной вершины, но ожидался результат пути"
            exit 1
        }
        "Начальной вершины нет в графе!" {
            puts "✗ Ошибка: Получена ошибка об отсутствии начальной вершины, но ожидался результат пути"
            exit 1
        }
        "Граф должен содержать не более 20 вершин" {
            puts "✗ Ошибка: Получена ошибка о слишком большом графе, но ожидался результат пути"
            exit 1
        }
        "Сервер вернул ошибку: некорректные данные графа" {
            puts "✗ Ошибка: Сервер вернул ошибку о некорректных данных"
            exit 1
        }
        "Не удалось получить результат" {
            puts "✗ Ошибка: Не удалось получить результат от сервера"
            exit 1
        }
        timeout {
            puts "✗ Таймаут при получении пути"
            exit 1
        }
    }

    # Завершаем сессию
    expect {
        "Пожалуйста, выберите способ задания графа: 'input' или 'read' (из файла)?" {
            expect "Input << "
            send "exit\r"

            expect {
                "Клиент отключен" {
                    puts "✅ Тест пройден успешно"
                    exit 0
                }
                eof {
                    puts "✅ Тест пройден успешно"
                    exit 0
                }
                timeout {
                    puts "⚠ Клиент не отключился, но тест пройден"
                    exit 0
                }
            }
        }
        eof {
            puts "✅ Тест пройден успешно (клиент завершил работу)"
            exit 0
        }
        timeout {
            puts "⚠ Таймаут после получения результата, но тест пройден"
            exit 0
        }
    }
}